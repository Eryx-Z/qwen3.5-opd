+    del cfg.distillation.teacher_models.teacher_model.inference.enable_sleep_mode
+    with pytest.raises(ValueError, match="teacher enable_sleep_mode must be false"):
+        teacher_resource_pool_id(cfg)
+
+
+@pytest.mark.parametrize(
+    "path,value",
+    [
+        ("trainer.n_gpus_per_node", 2),
+        ("trainer.nnodes", 2),
+        ("distillation.n_gpus_per_node", 2),
+        ("distillation.nnodes", 2),
+        ("actor_rollout_ref.hybrid_engine", False),
+        ("actor_rollout_ref.actor.strategy", "megatron"),
+        ("actor_rollout_ref.actor.use_kl_loss", True),
+        ("algorithm.use_kl_in_reward", True),
