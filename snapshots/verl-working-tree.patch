+from verl.workers.config.distillation import DistillationConfig, DistillationTeacherModelConfig
+from verl.workers.config.rollout import RolloutConfig
+
+
+def build_config(*, shared, sleep, free_cache):
+    return DistillationConfig(
+        enabled=True,
+        share_student_resource_pool=shared,
+        nnodes=1,
+        n_gpus_per_node=1,
+        # Isolate lifecycle validation from the unrelated loss/dataset registry.
+        distillation_loss=SimpleNamespace(loss_settings=SimpleNamespace(use_topk=False), topk=None),
+        teacher_models={
+            "teacher_model": DistillationTeacherModelConfig(
+                key="testteacher",
+                model_path="/unused/test-teacher",
+                inference=RolloutConfig(
+                    name="vllm",
+                    tensor_model_parallel_size=1,
+                    enable_sleep_mode=sleep,
+                    free_cache_engine=free_cache,
+                ),
+            )
+        },
+    )
+
+
+def test_runtime_config_accepts_resident_teacher_without_sleep_pool():
+    cfg = build_config(shared=True, sleep=False, free_cache=False)
+    inference = next(iter(cfg.teacher_models.values())).inference
+    assert inference.enable_sleep_mode is False
+    assert inference.free_cache_engine is False
