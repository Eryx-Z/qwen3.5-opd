+    OmegaConf.update(cfg, path, value)
+    with pytest.raises(ValueError, match="share_student_resource_pool"):
+        teacher_resource_pool_id(cfg)
+
+
+@pytest.mark.parametrize("prefix", ["actor_rollout_ref.rollout", "distillation.teacher_models.teacher_model.inference"])
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("name", "sglang"),
+        ("enforce_eager", False),
+        ("tensor_model_parallel_size", 2),
+        ("data_parallel_size", 2),
