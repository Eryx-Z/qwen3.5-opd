+++ b/examples/on_policy_distillation_trainer/diagnostics/sitecustomize.py
@@ -0,0 +1,190 @@
+"""Opt-in allocation tracing for one OPD diagnostic run; never imports CUDA eagerly."""
+
+import functools
+import importlib.abc
+import importlib.machinery
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+_ROOT = os.environ.get("OPD_DIAGNOSTIC_DIR")
+_TARGETS = {
+    "vllm.device_allocator.cumem",
+    "vllm.v1.worker.gpu_worker",
+    "vllm.model_executor.model_loader.default_loader",
+    "vllm.model_executor.model_loader.utils",
+    "vllm.model_executor.layers.quantization.fp8",
+    "verl.workers.engine.fsdp.transformer_impl",
+}
+
+
+def _emit(event, **fields):
+    if not _ROOT:
+        return
+    try:
+        root = Path(_ROOT)
+        root.mkdir(parents=True, exist_ok=True)
+        record = {"time": time.time(), "pid": os.getpid(), "event": event, **fields}
+        with (root / f"allocations-{os.getpid()}.jsonl").open("a") as f:
+            f.write(json.dumps(record, default=str) + "\n")
+            f.flush()
+    except Exception:
+        # Instrumentation must not change allocator return values or exceptions.
+        pass
+
+
+def _snapshot():
+    result = {}
+    try:
+        for line in Path("/proc/meminfo").read_text().splitlines():
+            key, value = line.split(":", 1)
+            if key in ("MemAvailable", "MemFree", "Cached", "SwapFree"):
+                result[key + "_bytes"] = int(value.split()[0]) * 1024
+        for line in Path("/proc/self/status").read_text().splitlines():
+            key, _, value = line.partition(":")
+            if key in ("VmRSS", "VmSize", "VmLck", "VmPin", "RssAnon", "RssFile"):
+                result[key + "_bytes"] = int(value.split()[0]) * 1024
+        torch = sys.modules.get("torch")
+        if torch is not None and torch.cuda.is_initialized():
+            result["torch_allocated_bytes"] = torch.cuda.memory_allocated()
+            result["torch_reserved_bytes"] = torch.cuda.memory_reserved()
+            free, total = torch.cuda.mem_get_info()
+            result["cuda_free_bytes"] = free
+            result["cuda_total_bytes"] = total
+    except Exception as error:
+        result["snapshot_error"] = repr(error)
+    return result
+
+
+def _wrap_stage(owner, name, label):
+    original = getattr(owner, name, None)
+    if original is None or getattr(original, "_opd_traced", False):
+        return
+
+    @functools.wraps(original)
+    def traced(*args, **kwargs):
+        model_path = None
+        for obj in args[:3]:
+            config = getattr(obj, "model_config", obj)
+            candidate = getattr(config, "model", None) or getattr(config, "path", None)
+            if isinstance(candidate, str):
+                model_path = candidate
+                break
+        _emit("stage_begin", stage=label, model_path=model_path, memory=_snapshot())
+        try:
+            value = original(*args, **kwargs)
+        except BaseException as error:
+            _emit("stage_error", stage=label, error=repr(error), memory=_snapshot())
+            raise
+        _emit("stage_end", stage=label, memory=_snapshot())
+        return value
+
+    traced._opd_traced = True
+    setattr(owner, name, traced)
+
+
+def _trace_cumem(cls):
+    original_malloc = cls._python_malloc_callback
+    original_free = cls._python_free_callback
+
+    def malloc(self, handle):
+        value = original_malloc(self, handle)
+        state = getattr(self, "_opd_allocation_state", None)
+        if state is None:
+            state = {"live": 0, "peak": 0, "allocated": 0, "freed": 0, "count": 0, "last_logged": 0, "last_time": 0}
+            self._opd_allocation_state = state
+        size = int(handle[1])
+        state["live"] += size
+        state["allocated"] += size
+        state["peak"] = max(state["peak"], state["live"])
+        state["count"] += 1
+        now = time.monotonic()
+        if abs(state["live"] - state["last_logged"]) >= 256 * 1024**2 or now - state["last_time"] >= 2:
+            state["last_logged"] = state["live"]
+            state["last_time"] = now
+            _emit(
+                "cumem_allocation",
+                tag=self.current_tag,
+                allocation_bytes=size,
+                live_handle_bytes=state["live"],
+                peak_handle_bytes=state["peak"],
+                cumulative_allocated_bytes=state["allocated"],
+                cumulative_freed_bytes=state["freed"],
+                allocation_count=state["count"],
+            )
+        return value
+
+    def free(self, ptr):
+        handle = original_free(self, ptr)
+        state = getattr(self, "_opd_allocation_state", None)
+        if state is not None:
+            state["live"] -= int(handle[1])
+            state["freed"] += int(handle[1])
+        return handle
+
+    cls._python_malloc_callback = malloc
+    cls._python_free_callback = free
+    for method in ("sleep", "wake_up", "release_pools"):
+        _wrap_stage(cls, method, "CuMemAllocator." + method)
+
+
+def _patch(module):
+    name = module.__name__
+    try:
+        if name == "vllm.device_allocator.cumem":
+            _trace_cumem(module.CuMemAllocator)
+        elif name == "vllm.v1.worker.gpu_worker":
+            for method in (
+                "init_device",
+                "load_model",
+                "determine_available_memory",
+                "initialize_from_config",
+                "compile_or_warm_up_model",
+            ):
+                _wrap_stage(module.Worker, method, "vLLM.Worker." + method)
+        elif name == "vllm.model_executor.model_loader.default_loader":
+            _wrap_stage(module.DefaultModelLoader, "load_weights", "vLLM.load_weights")
+        elif name == "vllm.model_executor.model_loader.utils":
+            _wrap_stage(module, "process_weights_after_loading", "vLLM.process_weights_after_loading")
+        elif name == "vllm.model_executor.layers.quantization.fp8":
+            _wrap_stage(module.Fp8MoEMethod, "process_weights_after_loading", "FP8.MoE.process_weights_after_loading")
+        elif name == "verl.workers.engine.fsdp.transformer_impl":
+            cls = module.FSDPEngineWithLMHead
+            for method in ("initialize", "_build_model_optimizer", "optimizer_step"):
+                _wrap_stage(cls, method, "FSDP." + method)
+        _emit("instrumentation_installed", module=name)
+    except Exception as error:
+        _emit("instrumentation_error", module=name, error=repr(error))
+
+
+class _TracingLoader:
+    def __init__(self, wrapped):
+        self.wrapped = wrapped
+
+    def create_module(self, spec):
+        method = getattr(self.wrapped, "create_module", None)
+        return method(spec) if method else None
+
+    def exec_module(self, module):
+        self.wrapped.exec_module(module)
+        _patch(module)
+
+    def __getattr__(self, name):
+        return getattr(self.wrapped, name)
+
+
+class _TracingFinder(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname not in _TARGETS:
+            return None
+        spec = importlib.machinery.PathFinder.find_spec(fullname, path, target)
+        if spec is not None and spec.loader is not None:
+            spec.loader = _TracingLoader(spec.loader)
+        return spec
+
+
+if _ROOT:
+    sys.meta_path.insert(0, _TracingFinder())
+    _emit("python_start", argv=sys.argv)
