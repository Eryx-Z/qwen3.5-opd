+"""Resource placement policy for the experimental single-GPU resident teacher."""
+
+
+def teacher_resource_pool_id(config):
+    """Validate the opt-in topology before actors are launched, and select its pool.
+
+    This deliberately supports only one FSDP hybrid student and one vLLM teacher.
+    Reusing the *same* pool (including its placement group) lets RayWorkerGroup's
+    fractional GPU reservations share a real device; creating a second pool would
+    reserve a second GPU regardless of the actors' fractional reservations.
+    """
+    distillation = config.distillation
+    if not distillation.get("share_student_resource_pool", False):
+        return "teacher_pool"
+
+    def require(condition, message):
+        if not condition:
+            raise ValueError(f"distillation.share_student_resource_pool: {message}")
+
+    require(config.trainer.nnodes == config.trainer.n_gpus_per_node == 1, "student must use one node and one GPU")
+    require(distillation.nnodes == distillation.n_gpus_per_node == 1, "teacher must use one node and one GPU")
+    student = config.actor_rollout_ref
+    require(student.hybrid_engine, "requires a hybrid student rollout")
+    require(student.actor.strategy in ("fsdp", "fsdp2"), "requires FSDP/FSDP2")
+    require(config.algorithm.adv_estimator == "grpo", "only critic-free GRPO is supported")
+    require(not student.actor.use_kl_loss and not config.algorithm.use_kl_in_reward, "reference policy is unsupported")
+    require(not config.reward.reward_model.enable, "reward model is unsupported")
+    require(
+        not config.reward.reward_model.get("enable_resource_pool", False), "separate reward GPU pool is unsupported"
+    )
+    teachers = distillation.teacher_models
+    require(len(teachers) == 1 and "teacher_model" in teachers, "requires the single teacher_model entry")
+    require(teachers.teacher_model.get("num_replicas", 0) in (0, 1), "requires one teacher replica")
+    require(
+        not teachers.teacher_model.inference.free_cache_engine,
+        "teacher free_cache_engine must be false (resident teacher)",
+    )
+    require(student.rollout.free_cache_engine, "student free_cache_engine must be true")
+    for name, inference in (("student", student.rollout), ("teacher", teachers.teacher_model.inference)):
+        require(inference.name == "vllm", f"{name} must use vLLM")
+        for field in (
+            "tensor_model_parallel_size",
+            "data_parallel_size",
+            "pipeline_model_parallel_size",
+            "expert_parallel_size",
+        ):
+            require(inference.get(field, 1) == 1, f"{name} {field} must be 1")
+        kwargs = inference.engine_kwargs.get("vllm", {})
+        # vLLM CLI serialization treats hyphens and underscores as aliases.
+        normalized_kwargs = {}
+        for key, value in kwargs.items():
+            canonical = key.replace("-", "_")
+            require(canonical not in normalized_kwargs, f"{name} duplicate engine_kwargs aliases for {canonical}")
+            normalized_kwargs[canonical] = value
+        # Do not let engine kwargs bypass the validated topology or lifecycle.
+        for field in (
+            "tensor_parallel_size",
+            "data_parallel_size",
+            "pipeline_parallel_size",
+            "enable_expert_parallel",
+            "enable_sleep_mode",
+            "enforce_eager",
+        ):
+            require(
+                field not in normalized_kwargs and f"no_{field}" not in normalized_kwargs,
+                f"{name} engine_kwargs cannot override {field}",
+            )
+        # Resident teachers must avoid vLLM's sleep-mode private memory pool:
+        # FP8 post-loading temporaries can remain reserved until loading ends.
+        expected_sleep_mode = name == "student"
+        require(
+            inference.get("enable_sleep_mode", True) == expected_sleep_mode,
+            f"{name} enable_sleep_mode must be {str(expected_sleep_mode).lower()}",
+        )
+        require(inference.enforce_eager, f"{name} enforce_eager must be true")
+        budget = normalized_kwargs.get("kv_cache_memory_bytes")
+        require(
+            isinstance(budget, int) and not isinstance(budget, bool) and budget > 0,
+            f"{name} requires a positive engine_kwargs.vllm.kv_cache_memory_bytes",
+        )
+    return "global_pool"
