+"""Execute the real wake/sleep methods without importing the GPU-only vLLM stack."""
+
+import ast
+import asyncio
+import logging
+from enum import Enum
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock, call
+
+import pytest
+
+
+@pytest.fixture(scope="module")
+def server_methods():
+    rollout_dir = Path(__file__).resolve().parents[3] / "verl/workers/rollout"
+    replica_path = rollout_dir / "replica.py"
+    replica_tree = ast.parse(replica_path.read_text(encoding="utf-8"))
+    rollout_mode = next(
+        node for node in replica_tree.body if isinstance(node, ast.ClassDef) and node.name == "RolloutMode"
+    )
+
+    server_path = rollout_dir / "vllm_rollout/vllm_async_server.py"
+    server_tree = ast.parse(server_path.read_text(encoding="utf-8"))
+    server_class = next(
+        node for node in server_tree.body if isinstance(node, ast.ClassDef) and node.name == "vLLMHttpServer"
+    )
+    methods = [
+        node
+        for node in server_class.body
+        if isinstance(node, ast.AsyncFunctionDef) and node.name in {"wake_up", "sleep"}
+    ]
+    assert {node.name for node in methods} == {"wake_up", "sleep"}
+    namespace = {"Enum": Enum, "logger": logging.getLogger(__name__)}
+    # Compile unchanged production AST nodes, not a copy of the method logic.
+    exec(compile(ast.Module(body=[rollout_mode, *methods], type_ignores=[]), str(server_path), "exec"), namespace)
+    return SimpleNamespace(**namespace)
+
+
+def make_server(methods, mode, *, enable_sleep_mode=True, free_cache_engine=True, node_rank=0):
+    engine = Mock(wake_up=AsyncMock(), reset_prefix_cache=AsyncMock(), sleep=AsyncMock())
+    return SimpleNamespace(
+        node_rank=node_rank,
+        rollout_mode=getattr(methods.RolloutMode, mode),
+        config=SimpleNamespace(enable_sleep_mode=enable_sleep_mode, free_cache_engine=free_cache_engine),
+        engine=engine,
+        _get_wake_up_tags=Mock(return_value=["weights", "kv_cache"]),
+        _sleep_hybrid=AsyncMock(),
+    )
+
+
+def test_resident_teacher_resets_prefix_without_engine_wake_or_sleep(server_methods):
+    server = make_server(server_methods, "COLOCATED", enable_sleep_mode=False, free_cache_engine=False)
+
+    asyncio.run(server_methods.wake_up(server))
+    asyncio.run(server_methods.sleep(server))
+
+    assert server.engine.mock_calls == [call.reset_prefix_cache(reset_connector=True)]
+    server.engine.reset_prefix_cache.assert_awaited_once_with(reset_connector=True)
+    server.engine.wake_up.assert_not_awaited()
+    server.engine.sleep.assert_not_awaited()
+    server._get_wake_up_tags.assert_not_called()
+
+
+@pytest.mark.parametrize("free_cache_engine", [False, True])
+@pytest.mark.parametrize("enable_sleep_mode", [False, True])
+def test_colocated_wake_respects_sleep_mode_and_keeps_cache_reset(server_methods, free_cache_engine, enable_sleep_mode):
+    server = make_server(
+        server_methods,
+        "COLOCATED",
+        enable_sleep_mode=enable_sleep_mode,
+        free_cache_engine=free_cache_engine,
+    )
+
+    asyncio.run(server_methods.wake_up(server, tags=["custom"]))
+
+    expected_calls = [call.reset_prefix_cache(reset_connector=True)]
+    if enable_sleep_mode:
+        expected_calls.insert(0, call.wake_up(tags=["weights", "kv_cache"]))
+        server.engine.wake_up.assert_awaited_once_with(tags=["weights", "kv_cache"])
+        server._get_wake_up_tags.assert_called_once_with()
+    else:
+        server.engine.wake_up.assert_not_awaited()
+        server._get_wake_up_tags.assert_not_called()
+    assert server.engine.mock_calls == expected_calls
+    server.engine.reset_prefix_cache.assert_awaited_once_with(reset_connector=True)
+
