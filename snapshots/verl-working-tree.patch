+        name="vllm",
+        enforce_eager=True,
+        enable_sleep_mode=True,
+        free_cache_engine=True,
+        tensor_model_parallel_size=1,
+        data_parallel_size=1,
+        pipeline_model_parallel_size=1,
+        expert_parallel_size=1,
+        engine_kwargs=dict(vllm=dict(kv_cache_memory_bytes=268435456)),
+    )
+    cfg = OmegaConf.create(
+        dict(
+            trainer=dict(nnodes=1, n_gpus_per_node=1),
+            algorithm=dict(adv_estimator="grpo", use_kl_in_reward=False),
+            reward=dict(reward_model=dict(enable=False)),
+            actor_rollout_ref=dict(
+                hybrid_engine=True, actor=dict(strategy="fsdp2", use_kl_loss=False), rollout=inference
+            ),
+            distillation=dict(
+                share_student_resource_pool=True,
+                nnodes=1,
+                n_gpus_per_node=1,
+                teacher_models=dict(teacher_model=dict(inference=inference)),
+            ),
