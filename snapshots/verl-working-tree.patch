+# Copyright 2026 verl contributors
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+"""Shared placement reuses bundles, not extra (or fictitious) GPU resources."""
+
+from unittest.mock import MagicMock
+
+import pytest
+
+pytest.importorskip("torch")
+pytest.importorskip("ray")
+from verl.single_controller.ray.base import RayWorkerGroup, ResourcePoolManager, split_resource_pool
+
+
+def test_teacher_nested_slices_keep_student_placement_and_fractional_claims(monkeypatch):
+    import verl.single_controller.ray.base as base
+
+    monkeypatch.setattr(base.ray._private.state, "available_resources_per_node", lambda: {"node": {"GPU": 1}})
+    manager = ResourcePoolManager({"global_pool": [1]}, {"student": "global_pool", "teacher": "global_pool"})
+    manager.create_resource_pool()
+    assert manager.get_n_gpus() == 1
+    student = manager.get_resource_pool("student")
+    assert manager.get_resource_pool("teacher") is student
+    pg = MagicMock()
+    student.pgs = [pg]
+    # MultiTeacherModelManager splits once, TeacherModelManager splits a second time.
+    teacher = split_resource_pool(split_resource_pool(student, [1])[0], 1)[0]
+    assert teacher.pgs is student.pgs
+    assert teacher.start_bundle_index == 0
+    assert teacher.max_colocate_count == student.max_colocate_count == 3
+
+    claims = []
+    for rank, pool in enumerate((student, teacher)):
+        group = MagicMock()
+        group.use_gpu = True
+        group.name_prefix = f"test_{rank}"
+        group.device_name = "cuda"
+        group.profile_steps = None
+        group._workers = []
+        group._worker_names = []
+        group._master_addr = "localhost"
+        group._master_port = "12345"
+        cls = MagicMock()
+        RayWorkerGroup._create_worker(group, 0, 0, pg, 0, pool, cls, None, False)
+        claim = cls.call_args.kwargs
+        assert claim["placement_group"] is pg
+        assert claim["placement_group_bundle_idx"] == 0
+        assert claim["num_gpus"] == pytest.approx(1 / 3)
+        claims.append(claim["num_gpus"])
+    assert sum(claims) < 1  # no bundle overclaim; one slot remains for a hybrid checkpoint worker
diff --git a/tests/trainer/test_opd_allocation_trace_on_cpu.py b/tests/trainer/test_opd_allocation_trace_on_cpu.py
