--- /dev/null
+++ b/tests/trainer/test_opd_diagnostic_guard_on_cpu.py
@@ -0,0 +1,197 @@
+"""No GPU, Ray import, live training, or real process signals."""
+
+import importlib.util
+import json
+import signal
+from pathlib import Path
+
+import pytest
+
+PATH = Path(__file__).resolve().parents[2] / "examples/on_policy_distillation_trainer/diagnostics/guard.py"
+spec = importlib.util.spec_from_file_location("opd_guard", PATH)
+guard = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(guard)
+
+
+def proc_row(root, pid, ppid=1, start=50, session=10, rss=5, argv=("python",)):
+    directory = root / str(pid)
+    directory.mkdir(exist_ok=True)
+    fields = ["0"] * 22
+    fields[0], fields[1], fields[3], fields[19], fields[21] = "S", str(ppid), str(session), str(start), str(rss)
+    (directory / "stat").write_text(f"{pid} (name with ) space) " + " ".join(fields))
+    (directory / "cmdline").write_bytes(b"\0".join(a.encode() for a in argv))
+    (directory / "environ").write_bytes(b"")
+
+
+def test_sensors_and_boundaries(tmp_path):
+    (tmp_path / "meminfo").write_text("MemAvailable: 20971520 kB\nSwapTotal: 100 kB\nSwapFree: 40 kB\n")
+    zone = tmp_path / "thermal_zone0"
+    zone.mkdir()
+    (zone / "type").write_text("acpitz\n")
+    (zone / "temp").write_text("40000\n")
+    snapshot = {"memory": guard.memory_snapshot(tmp_path), "thermal": guard.thermal_snapshot(tmp_path)}
+    assert snapshot["memory"]["MemAvailable"] == 20 * guard.GIB
+    assert snapshot["memory"]["SwapFree"] == 40960
+    assert snapshot["thermal"][0]["type"] == "acpitz"
+    assert guard.stop_reason(snapshot, 0, 600, 20 * guard.GIB, 75) is None
+    assert guard.stop_reason(snapshot, 600, 600, 20 * guard.GIB, 75) == "timeout"
+    snapshot["memory"]["MemAvailable"] -= 1
+    assert guard.stop_reason(snapshot, 0, 600, 20 * guard.GIB, 75) == "low_memavailable"
+    snapshot["memory"]["MemAvailable"] += 1
+    snapshot["thermal"][0]["celsius"] = 75
+    assert guard.stop_reason(snapshot, 0, 600, 20 * guard.GIB, 75) == "thermal_limit"
+
+
+def test_missing_and_broken_sensors_fail_closed(tmp_path):
+    with pytest.raises(ValueError, match="no thermal"):
+        guard.thermal_snapshot(tmp_path)
+    (tmp_path / "meminfo").write_text("MemTotal: 100 kB\n")
+    with pytest.raises(ValueError, match="MemAvailable"):
+        guard.memory_snapshot(tmp_path)
+    zone = tmp_path / "thermal_zone0"
+    zone.mkdir()
+    (zone / "temp").write_text("not a number")
+    with pytest.raises(ValueError):
+        guard.thermal_snapshot(tmp_path)
+
+
+def test_discovery_reparenting_pid_reuse_and_guard_exclusion(tmp_path):
+    proc_row(tmp_path, 10, session=10)
+    proc_row(tmp_path, 11, ppid=10, session=99)
+    proc_row(tmp_path, 12, session=99, argv=("raylet", "--temp-dir=/unique/ray"))
+    proc_row(tmp_path, 13, session=99)
+    (tmp_path / "13/environ").write_bytes(b"VERL_OPD_GUARD_RUN=token\0")
+    proc_row(tmp_path, 14, session=99)
+    proc_row(tmp_path, 20, session=10)
+    tracked = {(14, 49)}  # reused PID is not owned
+    guard.discover(guard.process_table(tmp_path), tracked, (10, 50), "token", Path("/unique/ray"), tmp_path, 20)
+    assert tracked == {(10, 50), (11, 50), (12, 50), (13, 50), (14, 49)}
+    proc_row(tmp_path, 11, ppid=1, session=99)
+    guard.discover(guard.process_table(tmp_path), tracked, (10, 50), "token", Path("/unique/ray"), tmp_path, 20)
+    assert (11, 50) in tracked
+    assert guard.process_table(tmp_path)[11]["rss_bytes"] == 5 * guard.os.sysconf("SC_PAGE_SIZE")
+
+
+def test_signals_only_matching_identity_not_guardian(tmp_path, monkeypatch):
+    proc_row(tmp_path, 10)
+    calls = []
+    monkeypatch.delattr(guard.os, "pidfd_open", raising=False)
+    monkeypatch.setattr(guard.os, "kill", lambda pid, sig: calls.append((pid, sig)))
+    assert not guard.send_verified((10, 49), signal.SIGTERM, tmp_path, 20)
+    assert not guard.send_verified((10, 50), signal.SIGTERM, tmp_path, 10)
+    assert guard.send_verified((10, 50), signal.SIGTERM, tmp_path, 20)
+    assert calls == [(10, signal.SIGTERM)]
+
+
+def test_cleanup_term_then_kill_only_owned(monkeypatch, tmp_path):
+    proc_row(tmp_path, 10)
+    proc_row(tmp_path, 11, session=99)
+    table = guard.process_table(tmp_path)
+    monkeypatch.setattr(guard, "process_table", lambda: table)
+    monkeypatch.setattr(guard, "discover", lambda *args: None)
+    clock = iter([0, 6, 10, 14])
+    monkeypatch.setattr(guard.time, "monotonic", lambda: next(clock))
+    calls = []
+
+    def send(target, sig):
+        calls.append((target, sig))
+        if sig == signal.SIGKILL:
+            table.pop(target[0])
+
+    monkeypatch.setattr(guard, "send_verified", send)
+    monkeypatch.setattr(guard.time, "sleep", lambda seconds: None)
+    with (tmp_path / "log").open("w") as output:
+        result = guard.cleanup({(10, 50), (11, 49)}, (10, 50), "token", Path("/unique"), output)
+    assert result["ok"]
+    assert calls == [((10, 50), signal.SIGTERM), ((10, 50), signal.SIGKILL)]
+    assert 11 in table
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ("raylet",),
+        ("gcs_server",),
+        ("ray::Worker",),
+        ("python", "-m", "verl.trainer.main_ppo"),
+        ("python", "/opt/ray/dashboard/dashboard.py"),
+        ("bash", "run_qwen3_5_single_gpu_smoke.sh"),
+    ],
+)
+def test_existing_job_rejection(argv):
+    assert guard.existing_job({"argv": argv})
+
+
+def test_monitor_failure_prevents_launch_and_records_outcome(tmp_path, monkeypatch):
+    monkeypatch.setattr(guard, "process_table", lambda: {})
+    monkeypatch.setattr(guard, "memory_snapshot", lambda: (_ for _ in ()).throw(OSError("sensor failed")))
+    monkeypatch.setattr(guard.subprocess, "Popen", lambda *a, **kw: pytest.fail("must not launch"))
+    assert guard.main(["--log-dir", str(tmp_path), "--", "bash", "smoke.sh"]) == 2
+    outcome = json.loads((tmp_path / "outcome.json").read_text())
+    assert outcome["reason"] == "monitor_or_guard_error"
+    assert "sensor failed" in outcome["error"]
+
+
+def test_monitor_failure_after_launch_cleans_child(tmp_path, monkeypatch):
+    row = {
+        "pid": 100,
+        "ppid": 1,
+        "session": 100,
+        "starttime": 50,
+        "rss_bytes": 0,
+        "state": "S",
+        "argv": ["bash"],
+        "cmd": "bash",
+    }
+    monkeypatch.setattr(guard, "process_table", lambda: {100: row, guard.os.getpid(): dict(row, pid=guard.os.getpid())})
+    monkeypatch.setattr(guard, "memory_snapshot", lambda: {"MemAvailable": 21 * guard.GIB})
+    calls = []
+
+    def thermal():
+        if calls:
+            raise OSError("lost thermal sensor")
+        calls.append("preflight")
+        return [{"celsius": 40}]
+
+    monkeypatch.setattr(guard, "thermal_snapshot", thermal)
+
+    class Child:
+        pid = 100
+        returncode = None
+
+        def wait(self, timeout):
+            self.returncode = -15
+
+    def launch(command, **kwargs):
+        assert command[-1] == f"+ray_kwargs.ray_init._temp_dir={tmp_path}/ray"
+        assert kwargs["start_new_session"]
+        assert guard.MARKER in kwargs["env"]
+        return Child()
+
+    def cleanup(tracked, child_identity, *args):
+        assert child_identity == (100, 50)
+        assert child_identity in tracked
+        calls.append("cleanup")
+        return {"ok": True}
+
+    monkeypatch.setattr(guard.subprocess, "Popen", launch)
+    monkeypatch.setattr(guard, "cleanup", cleanup)
+    assert guard.main(["--log-dir", str(tmp_path), "--", "bash", "smoke.sh"]) == 2
+    assert calls == ["preflight", "cleanup"]
+    outcome = json.loads((tmp_path / "outcome.json").read_text())
+    assert outcome["reason"] == "monitor_or_guard_error"
+    assert outcome["cleanup"]["ok"]
+
+
+def test_optional_pressure_and_extra_memory_fields(tmp_path):
+    (tmp_path / "meminfo").write_text(
+        "MemAvailable: 10 kB\nMemFree: 4 kB\nCached: 6 kB\nMlocked: 2 kB\nUnevictable: 3 kB\n"
+    )
+    assert guard.memory_snapshot(tmp_path)["MemFree"] == 4096
+    assert guard.memory_snapshot(tmp_path)["Cached"] == 6144
+    assert guard.memory_snapshot(tmp_path)["Mlocked"] == 2048
+    assert guard.memory_snapshot(tmp_path)["CmaFree"] is None
+    assert "error" in guard.pressure_snapshot(tmp_path)
+    (tmp_path / "pressure").mkdir()
+    (tmp_path / "pressure/memory").write_text("some avg10=0.00 total=123\n")
+    assert guard.pressure_snapshot(tmp_path) == "some avg10=0.00 total=123"
