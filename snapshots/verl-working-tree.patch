+        build_config(shared=True, sleep=sleep, free_cache=free_cache)
+
+
+def test_default_separate_teacher_sleep_behavior_is_unchanged():
+    cfg = build_config(shared=False, sleep=True, free_cache=True)
+    assert next(iter(cfg.teacher_models.values())).inference.enable_sleep_mode is True
