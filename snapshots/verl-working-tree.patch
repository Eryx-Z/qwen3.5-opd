index 00000000..4fbc4085
--- /dev/null
+++ b/tests/trainer/test_opd_allocation_trace_on_cpu.py
@@ -0,0 +1,66 @@
+"""Diagnostic hooks preserve wrapped behavior and do not import CUDA eagerly."""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+_PATH = Path(__file__).parents[2] / "examples/on_policy_distillation_trainer/diagnostics/sitecustomize.py"
+
+
+def load_trace():
+    spec = importlib.util.spec_from_file_location("opd_allocation_trace", _PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_allocator_hooks_preserve_handles_and_account_live_bytes():
+    module = load_trace()
+
+    class Allocator:
+        def __init__(self):
+            self.current_tag = "weights"
+            self.pointer_to_data = {}
+
+        def _python_malloc_callback(self, handle):
+            self.pointer_to_data[handle[2]] = handle
+
+        def _python_free_callback(self, pointer):
+            return self.pointer_to_data.pop(pointer)
+
+    module._trace_cumem(Allocator)
+    allocator = Allocator()
+    first, second = (0, 1024, 1, []), (0, 2048, 2, [])
+    assert allocator._python_malloc_callback(first) is None
+    allocator._python_malloc_callback(second)
+    assert allocator._opd_allocation_state["live"] == 3072
+    assert allocator._python_free_callback(1) == first
+    assert allocator._opd_allocation_state["live"] == 2048
+    assert allocator._python_free_callback(2) == second
+    assert allocator._opd_allocation_state["live"] == 0
+    assert allocator._opd_allocation_state["peak"] == 3072
+
+
+def test_stage_hooks_preserve_return_and_exception(monkeypatch):
+    module = load_trace()
+    events = []
+    monkeypatch.setattr(module, "_emit", lambda event, **fields: events.append((event, fields)))
+    monkeypatch.setattr(module, "_snapshot", lambda: {})
+
+    class Stage:
+        def method(self, value):
+            return value + 1
+
+        def fail(self):
+            raise RuntimeError("original error")
+
+    module._wrap_stage(Stage, "method", "test.method")
+    wrapped = Stage.method
+    module._wrap_stage(Stage, "method", "test.method")
+    assert Stage.method is wrapped
+    assert Stage().method(2) == 3
+    module._wrap_stage(Stage, "fail", "test.fail")
+    with pytest.raises(RuntimeError, match="original error"):
+        Stage().fail()
+    assert [event for event, _ in events] == ["stage_begin", "stage_end", "stage_begin", "stage_error"]
