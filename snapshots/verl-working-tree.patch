@@ -0,0 +1,355 @@
+#!/usr/bin/env python3
+"""Linux-only, dependency-free supervisor for the single-GPU OPD diagnostic run."""
+
+import argparse
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import uuid
+from pathlib import Path
+
+GIB = 1024**3
+MARKER = "VERL_OPD_GUARD_RUN"
+
+
+def memory_snapshot(proc=Path("/proc")):
+    values = {}
+    for line in (proc / "meminfo").read_text().splitlines():
+        key, value = line.split(":", 1)
+        fields = value.split()
+        values[key] = int(fields[0]) * (1024 if fields[1:] == ["kB"] else 1)
+    if "MemAvailable" not in values:
+        raise ValueError("MemAvailable unavailable")
+    return {
+        key: values.get(key)
+        for key in (
+            "MemAvailable",
+            "MemFree",
+            "MemTotal",
+            "Cached",
+            "Buffers",
+            "Shmem",
+            "SReclaimable",
+            "SwapTotal",
+            "SwapFree",
+            "Mlocked",
+            "Unevictable",
+            "AnonPages",
+            "CmaFree",
+            "PageTables",
+        )
+    }
+
+
+def thermal_snapshot(root=Path("/sys/class/thermal")):
+    zones = []
+    for zone in sorted(root.glob("thermal_zone*")):
+        value = int((zone / "temp").read_text().strip()) / 1000
+        if not -40 <= value <= 150:
+            raise ValueError(f"invalid thermal reading: {zone}: {value}")
+        zones.append({"zone": zone.name, "type": (zone / "type").read_text().strip(), "celsius": value})
+    if not zones:
+        raise ValueError("no thermal zones available")
+    return zones
+
+
+def process_table(proc=Path("/proc")):
+    result = {}
+    for entry in proc.iterdir():
+        if not entry.name.isdigit():
+            continue
+        try:
+            stat = (entry / "stat").read_text()
+            # comm may contain spaces or closing parentheses; stat fields start after the last ')'.
+            fields = stat[stat.rfind(")") + 2 :].split()
+            argv = (entry / "cmdline").read_bytes().split(b"\0")
+            result[int(entry.name)] = {
+                "pid": int(entry.name),
+                "ppid": int(fields[1]),
+                "session": int(fields[3]),
+                "starttime": int(fields[19]),
+                "rss_bytes": max(0, int(fields[21])) * os.sysconf("SC_PAGE_SIZE"),
+                "state": fields[0],
+                "cmd": " ".join(x.decode(errors="replace") for x in argv if x),
+                "argv": [x.decode(errors="replace") for x in argv if x],
+            }
+        except (FileNotFoundError, ProcessLookupError, PermissionError):
+            continue  # ordinary process exit races / unrelated inaccessible processes
+    return result
+
+
+def identity(row):
+    return row["pid"], row["starttime"]
+
+
+def existing_job(row):
+    argv = row["argv"]
+    if not argv:
+        return False
+    name = Path(argv[0]).name
+    return (
+        name in {"raylet", "gcs_server"}
+        or name.startswith("ray::")
+        or any(arg.startswith("verl.trainer.") for arg in argv)
+        or any("vllm.entrypoints" in arg for arg in argv)
+        or any("/ray/_private/" in arg or "/ray/dashboard/" in arg for arg in argv)
+        or any(
+            Path(arg).name in {"run_qwen3_5_single_gpu_smoke.sh", "run_qwen3_5_2b_fsdp.sh"}
+            for arg in argv[1:]
+            if name in {"bash", "sh"}
+        )
+        or name.startswith("VLLM::")
+    )
+
+
+def discover(table, tracked, child_identity, run_id, ray_dir, proc=Path("/proc"), guardian=None):
+    """Retain identities after reparenting; find detached Ray processes by unique run tags."""
+    guardian = os.getpid() if guardian is None else guardian
+    owned = {pid for pid, start in tracked if pid in table and table[pid]["starttime"] == start}
+    child_pid, child_start = child_identity
+    if child_pid in table and table[child_pid]["starttime"] == child_start:
+        owned.add(child_pid)
+    for pid, row in table.items():
+        if pid == guardian:
+            continue
+        tagged = str(ray_dir) in row["cmd"]
+        if not tagged:
+            try:
+                tagged = f"{MARKER}={run_id}".encode() in (proc / str(pid) / "environ").read_bytes().split(b"\0")
+            except (FileNotFoundError, PermissionError, ProcessLookupError):
+                pass
+        # Popen creates a dedicated session. Unlike a process-group kill, enumerate and verify each PID.
+        if tagged or row["session"] == child_pid:
+            owned.add(pid)
+    while True:
+        added = {pid for pid, row in table.items() if row["ppid"] in owned and pid != guardian}
+        if added <= owned:
+            break
+        owned |= added
+    tracked.update(identity(table[pid]) for pid in owned if pid != guardian)
+    return tracked
+
+
+def send_verified(target, sig, proc=Path("/proc"), guardian=None):
+    """Use pidfd when available so PID recycling between check and signal cannot hit a stranger."""
+    pid, start = target
+    guardian = os.getpid() if guardian is None else guardian
+    if pid == guardian or pid <= 1:
+        return False
+    fd = None
+    try:
+        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
+            fd = os.pidfd_open(pid)
+        row = process_table(proc).get(pid)
+        if row is None or row["starttime"] != start or row["state"] == "Z":
+            return False
+        if fd is not None:
+            signal.pidfd_send_signal(fd, sig)
+        else:
+            os.kill(pid, sig)
+        return True
+    except ProcessLookupError:
+        return False
+    finally:
+        if fd is not None:
+            os.close(fd)
+
+
+def stop_reason(snapshot, elapsed, timeout, min_memory, max_temp):
+    if snapshot["memory"]["MemAvailable"] < min_memory:
+        return "low_memavailable"
+    if max(zone["celsius"] for zone in snapshot["thermal"]) >= max_temp:
+        return "thermal_limit"
+    if elapsed >= timeout:
+        return "timeout"
+    return None
+
+
+def cgroup_snapshot(root=Path("/sys/fs/cgroup"), proc=Path("/proc")):
+    try:
+        relative = next(
+            line.split(":", 2)[2] for line in (proc / "self/cgroup").read_text().splitlines() if line.startswith("0::")
+        )
+        base = root / relative.lstrip("/")
+        return {
+            name: (base / name).read_text().strip()
+            for name in ("memory.current", "memory.max", "memory.events", "memory.swap.current")
+            if (base / name).exists()
+        }
+    except (OSError, StopIteration) as exc:
+        return {"error": str(exc)}
+
+
+def emit(handle, value):
+    handle.write(json.dumps(value, sort_keys=True) + "\n")
+    handle.flush()
+    os.fsync(handle.fileno())
+
+
+def pressure_snapshot(proc=Path("/proc")):
+    try:
+        return (proc / "pressure/memory").read_text().strip()
+    except OSError as exc:
+        return {"error": str(exc)}
+
+
+def snapshot(table, tracked):
+    return {
+        "timestamp": time.time(),
+        "memory": memory_snapshot(),
+        "thermal": thermal_snapshot(),
+        "cgroup": cgroup_snapshot(),
+        "memory_pressure": pressure_snapshot(),
+        "top_rss": [
+            {k: v for k, v in row.items() if k != "argv"}
+            for row in sorted(table.values(), key=lambda row: row["rss_bytes"], reverse=True)[:15]
+        ],
+        "tracked": [{"pid": pid, "starttime": start} for pid, start in sorted(tracked)],
+    }
+
+
+def cleanup(tracked, child_identity, run_id, ray_dir, telemetry):
+    errors = []
+    for sig, grace in ((signal.SIGTERM, 5), (signal.SIGKILL, 3)):
+        deadline = time.monotonic() + grace
+        while True:
+            table = process_table()
+            discover(table, tracked, child_identity, run_id, ray_dir)
+            alive = [
+                target
+                for target in tracked
+                if target[0] in table
+                and table[target[0]]["starttime"] == target[1]
+                and table[target[0]]["state"] != "Z"
+            ]
+            for target in alive:
+                try:
+                    send_verified(target, sig)
+                except OSError as exc:
+                    errors.append({"pid": target[0], "error": str(exc)})
+            if not alive or time.monotonic() >= deadline:
+                break
+            time.sleep(0.2)
+        emit(telemetry, {"timestamp": time.time(), "event": "cleanup", "signal": sig.name, "alive": alive})
+    table = process_table()
+    discover(table, tracked, child_identity, run_id, ray_dir)
+    remaining = [row for row in table.values() if identity(row) in tracked and row["state"] != "Z"]
+    return {"ok": not remaining and not errors, "remaining": remaining, "errors": errors}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--log-dir", type=Path, required=True)
+    parser.add_argument("--timeout", type=float, default=600)
+    parser.add_argument("--interval", type=float, default=1)
+    parser.add_argument("--min-mem-gib", type=float, default=20)
+    parser.add_argument("--max-temp-c", type=float, default=75)
+    parser.add_argument("command", nargs=argparse.REMAINDER)
+    args = parser.parse_args(argv)
+    command = args.command[1:] if args.command[:1] == ["--"] else args.command
+    if not command or min(args.interval, args.timeout, args.min_mem_gib) <= 0:
+        parser.error("provide a command after -- and positive interval, timeout, memory limit")
+    logdir = args.log_dir.resolve()
+    logdir.mkdir(parents=True, exist_ok=True)
+    # Refuse reused artifacts, preserving earlier evidence (other instrumentation files are allowed).
+    if any((logdir / name).exists() for name in ("guard.jsonl", "smoke.log", "control.json", "outcome.json", "ray")):
+        parser.error("log directory already contains guard artifacts; use a fresh run directory")
+    telemetry = (logdir / "guard.jsonl").open("x")
+    run_id = uuid.uuid4().hex
+    ray_dir = logdir / "ray"
+    tracked = set()
+    child = None
+    reason = "guard_error"
+    last = None
+    status = {"ok": True, "remaining": [], "errors": []}
+    interrupted = []
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        signal.signal(sig, lambda number, frame: interrupted.append(number))
+    outcome = {"run_id": run_id, "command": command, "ray_temp_dir": str(ray_dir)}
+    try:
+        table = process_table()
+        conflicts = [row for pid, row in table.items() if pid != os.getpid() and existing_job(row)]
+        if conflicts:
+            reason = "existing_jobs"
+            outcome["conflicts"] = conflicts
+            return 2
+        last = snapshot(table, tracked)
+        emit(telemetry, last)
+        reason = stop_reason(last, 0, args.timeout, args.min_mem_gib * GIB, args.max_temp_c)
+        if reason:
+            return 2
+        ray_dir.mkdir(exist_ok=False)
+        command = command + [f"+ray_kwargs.ray_init._temp_dir={ray_dir}"]
+        env = dict(os.environ, **{MARKER: run_id, "RAY_TMPDIR": str(ray_dir)})
+        env.setdefault("PYTHONUNBUFFERED", "1")
+        with (logdir / "smoke.log").open("xb", buffering=0) as output:
+            child = subprocess.Popen(command, env=env, stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
+            child_identity = (child.pid, -1)  # tags/session still allow cleanup if identity capture fails
+            row = process_table().get(child.pid)
+            if row is None:
+                raise RuntimeError("child disappeared before identity capture")
+            child_identity = identity(row)
+            tracked.add(child_identity)
+            with (logdir / "control.json").open("x") as control:
+                emit(
+                    control,
+                    {
+                        "guardian": identity(process_table()[os.getpid()]),
+                        "child": child_identity,
+                        "run_id": run_id,
+                        "ray_temp_dir": str(ray_dir),
+                    },
+                )
+            start = time.monotonic()
+            while True:
+                table = process_table()
+                discover(table, tracked, child_identity, run_id, ray_dir)
+                last = snapshot(table, tracked)
+                emit(telemetry, last)
+                reason = (
+                    "signal"
+                    if interrupted
+                    else stop_reason(
+                        last, time.monotonic() - start, args.timeout, args.min_mem_gib * GIB, args.max_temp_c
+                    )
+                )
+                if reason:
+                    break
+                if child.poll() is not None:
+                    reason = "child_exit"
+                    break
+                time.sleep(args.interval)
+        return 0 if reason == "child_exit" and child.returncode == 0 else 2
+    except Exception as exc:
+        reason = "monitor_or_guard_error"
+        outcome["error"] = f"{type(exc).__name__}: {exc}"
+        return 2
+    finally:
+        if child is not None:
+            # Even normal driver exit must clean up detached actors. Never kill by global Ray name.
+            try:
+                status = cleanup(tracked, child_identity, run_id, ray_dir, telemetry)
+                child.wait(timeout=1)
+            except Exception as exc:
+                status = {"ok": False, "error": f"{type(exc).__name__}: {exc}"}
+        outcome.update(
+            reason=reason,
+            last_snapshot=last,
+            cleanup=status,
+            child_returncode=child.returncode if child else None,
+            timestamp=time.time(),
+        )
+        with (logdir / "outcome.json").open("x") as output:
+            emit(output, outcome)
+        emit(telemetry, {"event": "outcome", **outcome})
+        telemetry.close()
+        # Cleanup failure must not look like a successful run to the caller.
+        if not status["ok"]:
+            sys.exit(3)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
