+    )
+    cfg.distillation.teacher_models.teacher_model.inference.free_cache_engine = False
+    cfg.distillation.teacher_models.teacher_model.inference.enable_sleep_mode = False
+    return cfg
+
+
+def test_shared_pool_is_the_actual_student_pool():
+    assert teacher_resource_pool_id(config()) == "global_pool"
+
+
+def test_default_does_not_validate_or_change_separate_pool():
+    assert teacher_resource_pool_id(OmegaConf.create({"distillation": {}})) == "teacher_pool"
+
+
+@pytest.mark.parametrize(
+    "prefix,value,expected",
+    [
+        ("actor_rollout_ref.rollout", False, "student enable_sleep_mode must be true"),
+        ("distillation.teacher_models.teacher_model.inference", True, "teacher enable_sleep_mode must be false"),
